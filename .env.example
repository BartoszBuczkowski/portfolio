# Canonical site URL (no trailing slash). Required in production (build fails without it).
# Used for Open Graph, canonical/hreflang, sitemap, and JSON-LD.
# Example: https://bartoszbuczkowski.pl
NEXT_PUBLIC_SITE_URL=https://bartoszbuczkowski.pl
NEXT_PUBLIC_SITE_LAST_MODIFIED=2026-07-07

# Optional: social profiles used in structured data (sameAs) and rich results.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/bartosz-r-buczkowski/
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TWITTER_HANDLE=

# Optional: Google Search Console HTML tag verification value.
GOOGLE_SITE_VERIFICATION=

# Public Turnstile site key (widget). Required for the contact form in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Turnstile secret used only on the server for siteverify. Do not expose to the client.
# Production: `pnpm exec wrangler secret put TURNSTILE_SECRET_KEY`
# Local preview / wrangler dev: add to `.dev.vars` in the project root (same variable name).
TURNSTILE_SECRET_KEY=

# D1 is bound in `wrangler.toml` (`[[d1_databases]]`), not here. After `wrangler d1 create`, set `database_id` in wrangler.toml and run migrations.

# Optional: used by OpenNext when loading Next.js env files during `wrangler dev` / preview (see Cloudflare Workers docs).
# NEXTJS_ENV=development
